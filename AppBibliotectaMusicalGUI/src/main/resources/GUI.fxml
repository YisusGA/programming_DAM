<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="550.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.dam1.controller.GUIController">
	<top>
		<MenuBar fx:id="menuBar" BorderPane.alignment="CENTER">
			<menus>
				<Menu text="Archivo">
					<items>
						<MenuItem fx:id="menuLimpiar" onAction="#limpiarFormulario" text="Limpiar Formulario" />
						<MenuItem fx:id="menuSalir" onAction="#cerrarPrograma" text="Salir" />
					</items>
				</Menu>
				<Menu text="Ayuda">
					<items>
						<MenuItem fx:id="menuAcercaDe" onAction="#mostrarInfoApp" text="Acerca de..." />
					</items>
				</Menu>
			</menus>
		</MenuBar>
	</top>
	<left>
		<VBox prefHeight="525.0" prefWidth="250.0" spacing="10.0" BorderPane.alignment="CENTER">
			<children>
				<Label prefHeight="43.0" prefWidth="210.0" text="Colección de Álbumes              (doble click para ver detalles)" wrapText="true">
					<font>
						<Font name="System Bold" size="13.0" />
					</font>
				</Label>
				<ListView fx:id="listaAlbumes" onMouseClicked="#mostrarDatosAlbum" VBox.vgrow="ALWAYS" />
			</children>
			<padding>
				<Insets bottom="15.0" left="15.0" right="10.0" top="15.0" />
			</padding>
		</VBox>
	</left>
	<center>
		<VBox spacing="15.0" BorderPane.alignment="CENTER">
			<padding>
				<Insets bottom="15.0" left="10.0" right="15.0" top="15.0" />
			</padding>
			<children>
				<Label text="Detalles del Álbum Seleccionado">
					<font>
						<Font name="System Bold" size="18.0" />
					</font>
				</Label>
				<Separator prefWidth="200.0" />
				<VBox spacing="5.0">
					<children>
						<Label text="Nombre del Álbum:" />
						<TextField fx:id="txtNombre" promptText="Ej: Dark Side of the Moon" />
					</children>
				</VBox>
				<VBox spacing="5.0">
					<children>
						<Label text="Artista / Banda:" />
						<TextField fx:id="txtArtista" promptText="Ej: Pink Floyd" />
					</children>
				</VBox>
				<VBox spacing="5.0">
					<children>
						<Label text="Género Musical:" />
						<ComboBox fx:id="comboGenero" prefWidth="200.0" promptText="Seleccionar género..." />
					</children>
				</VBox>
				<VBox spacing="5.0" VBox.vgrow="ALWAYS">
					<children>
						<Label text="Notas y Resumen:" />
						<TextArea fx:id="areaNotas" prefHeight="100.0" prefWidth="200.0" promptText="Escribe aquí una breve descripción del álbum..." wrapText="true" />
                  <Label fx:id="resultadoOperacion" alignment="CENTER" prefHeight="52.0" prefWidth="523.0" wrapText="true">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </Label>
					</children>
				</VBox>
				<Separator prefWidth="200.0" />
				<HBox alignment="CENTER_RIGHT" spacing="10.0">
					<children>
						<Button fx:id="btnAddSong" onAction="#addSong" text="Añadir canciones" />
						<Button fx:id="btnDelete" onAction="#eliminarAlbum" style="-fx-background-color: #ffcccc;" text="Eliminar Álbum" />
						<Button fx:id="btnAdd" onAction="#addAlbum" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #ccffcc;" text="Añadir Álbum">
							<font>
								<Font name="System Bold" size="12.0" />
							</font>
						</Button>
					</children>
				</HBox>
			</children>
		</VBox>
	</center>
</BorderPane>
